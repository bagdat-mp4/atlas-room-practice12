{
  "display": "form",
  "type": "form",
  "title": "Atlas 204 room checker",
  "name": "atlas204",
  "path": "atlas204",
  "components": [
    {
      "type": "columns",
      "key": "request",
      "label": "Request",
      "input": false,
      "columns": [
        {
          "width": 6,
          "currentWidth": 6,
          "size": "md",
          "components": [
            {
              "label": "Start time",
              "placeholder": "HH:MM",
              "applyMaskOn": "change",
              "autocomplete": "off",
              "tableView": false,
              "defaultValue": "12:00",
              "validateWhenHidden": false,
              "key": "start",
              "type": "textfield",
              "input": true,
              "inputType": "time"
            }
          ],
          "offset": 0,
          "push": 0,
          "pull": 0
        },
        {
          "width": 6,
          "currentWidth": 6,
          "size": "md",
          "components": [
            {
              "type": "textfield",
              "key": "duration",
              "label": "Duration (min)",
              "input": true,
              "tableView": false,
              "defaultValue": "45",
              "inputType": "text",
              "inputMode": "decimal",
              "autocomplete": "off"
            }
          ],
          "offset": 0,
          "push": 0,
          "pull": 0
        }
      ],
      "tableView": false
    },
    {
      "type": "checkbox",
      "key": "roomBlocked",
      "label": "Room blocked for maintenance",
      "input": true,
      "tableView": false,
      "defaultValue": false
    },
    {
      "type": "hidden",
      "key": "demoClock",
      "label": "demoClock",
      "input": true,
      "tableView": false,
      "persistent": false,
      "defaultValue": 540
    },
    {
      "type": "hidden",
      "key": "firstStart",
      "label": "firstStart",
      "input": true,
      "tableView": false,
      "persistent": false,
      "defaultValue": 600
    },
    {
      "type": "hidden",
      "key": "firstEnd",
      "label": "firstEnd",
      "input": true,
      "tableView": false,
      "persistent": false,
      "defaultValue": 660
    },
    {
      "type": "hidden",
      "key": "secondStart",
      "label": "secondStart",
      "input": true,
      "tableView": false,
      "persistent": false,
      "defaultValue": 870
    },
    {
      "type": "hidden",
      "key": "secondEnd",
      "label": "secondEnd",
      "input": true,
      "tableView": false,
      "persistent": false,
      "defaultValue": 930
    },
    {
      "type": "hidden",
      "key": "startMinute",
      "label": "startMinute",
      "input": true,
      "tableView": false,
      "persistent": false,
      "calculateValue": "const m = /^(\\d{2}):(\\d{2})$/.exec(String(data.start || '').trim());\nvalue = m && Number(m[1]) < 24 && Number(m[2]) < 60 ? Number(m[1]) * 60 + Number(m[2]) : -1;"
    },
    {
      "type": "hidden",
      "key": "durationMinutes",
      "label": "durationMinutes",
      "input": true,
      "tableView": false,
      "persistent": false,
      "calculateValue": "const raw = String(data.duration ?? '').trim();\nvalue = /^[-+]?\\d+(?:\\.\\d+)?$/.test(raw) ? Number(raw) : -1;"
    },
    {
      "type": "hidden",
      "key": "reasonCode",
      "label": "reasonCode",
      "input": true,
      "tableView": false,
      "persistent": false,
      "calculateValue": {
        "if": [
          {
            "or": [
              {
                "<": [
                  {
                    "var": "data.startMinute"
                  },
                  0
                ]
              },
              {
                "<=": [
                  {
                    "var": "data.durationMinutes"
                  },
                  0
                ]
              },
              {
                "!=": [
                  {
                    "%": [
                      {
                        "var": "data.durationMinutes"
                      },
                      1
                    ]
                  },
                  0
                ]
              },
              {
                ">": [
                  {
                    "+": [
                      {
                        "var": "data.startMinute"
                      },
                      {
                        "var": "data.durationMinutes"
                      }
                    ]
                  },
                  1440
                ]
              }
            ]
          },
          "INVALID_INTERVAL",
          {
            "<=": [
              {
                "var": "data.startMinute"
              },
              {
                "var": "data.demoClock"
              }
            ]
          },
          "NOT_FUTURE",
          {
            ">": [
              {
                "var": "data.durationMinutes"
              },
              120
            ]
          },
          "TOO_LONG",
          {
            "var": "data.roomBlocked"
          },
          "BLOCKED",
          {
            "or": [
              {
                "and": [
                  {
                    "<": [
                      {
                        "var": "data.startMinute"
                      },
                      {
                        "var": "data.firstEnd"
                      }
                    ]
                  },
                  {
                    ">": [
                      {
                        "+": [
                          {
                            "var": "data.startMinute"
                          },
                          {
                            "var": "data.durationMinutes"
                          }
                        ]
                      },
                      {
                        "var": "data.firstStart"
                      }
                    ]
                  }
                ]
              },
              {
                "and": [
                  {
                    "<": [
                      {
                        "var": "data.startMinute"
                      },
                      {
                        "var": "data.secondEnd"
                      }
                    ]
                  },
                  {
                    ">": [
                      {
                        "+": [
                          {
                            "var": "data.startMinute"
                          },
                          {
                            "var": "data.durationMinutes"
                          }
                        ]
                      },
                      {
                        "var": "data.secondStart"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          "OVERLAP",
          "AVAILABLE"
        ]
      }
    },
    {
      "type": "hidden",
      "key": "available",
      "label": "available",
      "input": true,
      "tableView": false,
      "persistent": false,
      "calculateValue": {
        "===": [
          {
            "var": "data.reasonCode"
          },
          "AVAILABLE"
        ]
      }
    },
    {
      "type": "textfield",
      "key": "message",
      "label": "Decision message",
      "input": true,
      "tableView": false,
      "disabled": true,
      "calculateValue": {
        "if": [
          {
            "===": [
              {
                "var": "data.reasonCode"
              },
              "AVAILABLE"
            ]
          },
          "The room is free for this interval.",
          {
            "===": [
              {
                "var": "data.reasonCode"
              },
              "OVERLAP"
            ]
          },
          "This interval overlaps an existing booking.",
          {
            "===": [
              {
                "var": "data.reasonCode"
              },
              "BLOCKED"
            ]
          },
          "The room is blocked for maintenance.",
          {
            "===": [
              {
                "var": "data.reasonCode"
              },
              "TOO_LONG"
            ]
          },
          "Use a duration of 120 minutes or less.",
          {
            "===": [
              {
                "var": "data.reasonCode"
              },
              "NOT_FUTURE"
            ]
          },
          "Choose a start time after the 09:00 demo clock.",
          "Enter a valid time and a positive whole number of minutes. Finish by 24:00."
        ]
      }
    }
  ]
}
